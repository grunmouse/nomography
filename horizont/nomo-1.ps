%!PS-Adobe-3.0
%%BeginSetup
  << /PageSize [595 842] /Orientation 0 >> setpagedevice
%%EndSetup

%(../../ps-steal/steal.ps) run
(../../ps-eskd/) stealfolder
(../../ps-eskd-font/) stealfolder
(../../nomography/ps/) stealfolder
(./nomo-1-config.ps) stealfile

	in2mm
	
	0.2 setlinewidth
	/eskd-b-font  findfont	2.2 scalefont setfont
	

/module 0.001 def % =1/1000, в 1 мм 1000 м = 1:1М

/scale_h_mm {
    0           10    10    5     1     next-linear-scale
    currentarg  30    10    2     null  next-linear-scale
    currentarg  50    20    10    5		next-linear-scale
    currentarg  70    20    10    5		next-linear-scale
    currentarg  100   30    10    5		next-linear-scale
    currentarg  150   50    10    5		next-linear-scale
    currentarg  200   50    10    null  next-linear-scale
    currentarg  600   100   50    10    next-linear-scale
} def

105 270 translate
gsave
{f_h 1.06 mul module mul 0} scale-env begin
	/dir {pop 90} def
	
	0 600 line
	
	0 value
	scale_h_mm
	
end

{f_h 1.06 mul module mul neg 0} scale-env begin
	/dir {pop 90} def
	
	0 600 line
	
	scale_h_mm

end
grestore

/eskd-b-font  findfont	2.5 scalefont setfont

50 20 moveto
(Расстояние: в 1 мм 1 км) show
-10 15 moveto
(Высота, м) show


%-90 -20 translate
%{1000 mul f_l module mul 0} scale-env begin
%	/dir {pop -90} def
%	%0 fun == ==
%			%center top settarget
%		/level0 3.5 def
%		/dlevel 1 def
%	0 150 line
%	%0 3 [1 10] [1 20] [1 100] linear-scale
%	0 150 10 5 1 linear-scale
%	
%end

